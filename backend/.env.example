# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Mongo (Atlas — required for Atlas Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quark-ai
VECTOR_SEARCH_INDEX=chunk_vector_index_512

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Email (Gmail app password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=quark-ai-files

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
ANTHROPIC_CHAT_TITLE_MODEL=claude-haiku-4-5
# Writes the daily admin brief (defaults to ANTHROPIC_CHAT_MODEL)
ANTHROPIC_REPORT_MODEL=claude-sonnet-4-5

# OpenAI (embeddings and low-cost WhatsApp ingestion decisions)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Changing this requires re-embedding all chunks (scripts/migrations/embeddings-512.js)
OPENAI_EMBEDDING_DIMENSIONS=512
OPENAI_INGESTION_MODEL=gpt-5.4-nano

# WhatsApp text ingestion is coalesced per integration + chat + project.
WHATSAPP_INGESTION_BATCH_WINDOW_MS=300000
WHATSAPP_INGESTION_BATCH_MAX_MESSAGES=30
WHATSAPP_INGESTION_BATCH_MAX_CHARS=12000
WHATSAPP_INGESTION_BATCH_POLL_MS=15000

# Email (IMAP) ingestion: how often linked mailboxes are checked for new mail,
# and how often pending emails are sent through memory ingestion.
EMAIL_SYNC_POLL_MS=120000
EMAIL_INGESTION_POLL_MS=15000

# WhatsApp messages from chats that no project uses are deleted after this
# many days (linking the chat to a project keeps its history).
WHATSAPP_UNLINKED_MESSAGE_RETENTION_DAYS=30

# Cheerio AI: public base URL of this API (ending in /api), used in the
# webhook URLs shown on the Integrations page. Required behind Nginx.
PUBLIC_API_URL=http://localhost:4000/api
CHEERIO_INGESTION_POLL_MS=15000

# Daily brief emailed to org admins: once per org per day, at or after
# DAILY_REPORT_HOUR (0-23) in DAILY_REPORT_TIMEZONE. Quiet days send nothing.
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=9
DAILY_REPORT_TIMEZONE=Asia/Kolkata
DAILY_REPORT_POLL_MS=300000

# Grok
GROK_API_KEY=

# Google Sheets & Docs for chat: base64 of the service account JSON key.
#   base64 -i quark-ai-docs-key.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=

# Sentry (error monitoring, logs, tracing, profiling)
SENTRY_DSN=
# Error budget per process, to stay inside Sentry's free 5k errors/month:
# each distinct error is sent at most N times an hour, all errors at most M an hour.
SENTRY_MAX_EVENTS_PER_ERROR_PER_HOUR=2
SENTRY_MAX_ERRORS_PER_HOUR=6

# Integrations — 64-char hex string (32 bytes), used to encrypt stored
# credentials (e.g. WhatsApp session data) at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=
