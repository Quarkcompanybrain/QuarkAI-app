# Server
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Mongo (Atlas — required for Atlas Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quark-ai
VECTOR_INDEX_NAME=chunk_vector_index

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Email (Gmail app password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=quark-ai-files

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5
ANTHROPIC_CHUNK_MODEL=claude-haiku-4-5

# OpenAI (embeddings only)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Grok
GROK_API_KEY=

# Sentry (error monitoring, logs, tracing, profiling)
SENTRY_DSN=
